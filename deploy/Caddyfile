{
    email contact@raony.dev
}
raony.dev {
    encode zstd gzip
    redir /astroflux /astroflux/?{query} 308
    handle /astroflux/private/* {
        reverse_proxy 127.0.0.1:8094 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle_path /astroflux/upstream/* {
        @asset {
            method GET HEAD
            path /astroflux.js /playerio/* /ui/* /fonts/* /textures/* /data/* /sound/* /manifest/*
        }
        handle @asset {
          reverse_proxy https://astroflux.net {
            header_up Host astroflux.net
            header_up -Cookie
            header_up -Authorization
            header_up -Origin
            header_up -Referer
            header_down -Set-Cookie
            header_down Cache-Control "no-cache"
        }
        }
        handle {
          respond "Not found" 404
        }
    }
    handle_path /astroflux/* {
        root * /srv/raony/astroflux
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        root * /srv/raony/site
        file_server
    }
}
mail.raony.dev {
    reverse_proxy 127.0.0.1:8080
}
